// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated admin users can access all data
    function isAuth() {
      return request.auth != null;
    }

    // All collections require authentication (single-role admin system)
    match /menu_items/{id} {
      allow read, write: if isAuth();
    }

    match /orders/{id} {
      allow read, write: if isAuth();
    }

    match /inventory/{id} {
      allow read, write: if isAuth();
    }

    match /inventory_logs/{id} {
      allow read, write: if isAuth();
    }

    match /users/{id} {
      allow read, write: if isAuth();
    }
  }
}
